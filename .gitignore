# 既定ですべて無視し、プロジェクトのパスだけ戻す
/*
!/.github/
!/public/
!/tests/
!/tools/
!/.gitattributes
!/.gitignore
!/.nvmrc
!/.prettierrc.json
!/CHANGELOG.md
!/LICENSE
!/README.md
!/eslint.config.js
!/package.json
!/package-lock.json
!/vitest.config.js

# 許可したパスの中でも、機密・私的データは再度止める
.env
.env.*
*.pem
*.key
id_rsa*
**/secrets.*
**/credentials.*
.DS_Store
Thumbs.db
desktop.ini

# Fixtures: 実データは無視し、サンプルだけ残す
tests/fixtures/securities_yen/**
!tests/fixtures/securities_yen/SampleData.json
tests/fixtures/securities_usd/**
!tests/fixtures/securities_usd/SampleData.json
